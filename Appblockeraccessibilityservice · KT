package com.yourname.focusagent.service

import android.accessibilityservice.AccessibilityService
import android.content.Intent
import android.view.accessibility.AccessibilityEvent
import com.yourname.focusagent.data.AppDatabase
import com.yourname.focusagent.data.UsageEvent
import com.yourname.focusagent.ui.InterceptionOverlayActivity
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch

/**
 * Phase 3 core: detects foreground-app changes via AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED
 * and intercepts configured "distraction" packages before the user can scroll.
 *
 * Why AccessibilityService and not UsageStatsManager:
 *   UsageStatsManager only tells you usage AFTER THE FACT (polled, minutes-delayed).
 *   AccessibilityService fires the instant a new window comes to the foreground —
 *   this is the only way to intercept BEFORE the feed renders.
 */
class AppBlockerAccessibilityService : AccessibilityService() {

    private val scope = CoroutineScope(Dispatchers.IO)

    // Configure this from user_profile.primary_distractions at service start,
    // rather than hardcoding — shown hardcoded here for clarity.
    private val blockedPackages = setOf(
        "com.instagram.android",
        "com.google.android.youtube", // you'll likely want to allow-list specific
                                       // YouTube use-cases later; start blunt, refine later
        "com.zhiliaoapp.musically",   // TikTok
        "com.reddit.frontpage"
    )

    // Debounce: avoid re-triggering the overlay repeatedly for the same app session
    private var lastBlockedPackage: String? = null
    private var lastBlockedAtMillis: Long = 0L
    private val debounceWindowMillis = 3000L

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
        if (event?.eventType != AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED) return
        val packageName = event.packageName?.toString() ?: return

        // Always log the raw event locally (Room), even for non-blocked apps —
        // this is what feeds the nightly aggregation for the scheduler.
        logUsageEvent(packageName)

        if (packageName !in blockedPackages) {
            lastBlockedPackage = null
            return
        }

        val now = System.currentTimeMillis()
        val isDuplicateWithinWindow =
            packageName == lastBlockedPackage && (now - lastBlockedAtMillis) < debounceWindowMillis
        if (isDuplicateWithinWindow) return

        lastBlockedPackage = packageName
        lastBlockedAtMillis = now
        interceptApp(packageName)
    }

    private fun interceptApp(packageName: String) {
        logUsageEvent(packageName, eventType = "intercepted")

        // Launch the overlay/replacement activity full-screen, on top of everything,
        // as a new task (required since we're launching from a Service context).
        val intent = Intent(this, InterceptionOverlayActivity::class.java).apply {
            addFlags(
                Intent.FLAG_ACTIVITY_NEW_TASK or
                Intent.FLAG_ACTIVITY_CLEAR_TOP or
                Intent.FLAG_ACTIVITY_SINGLE_TOP
            )
            putExtra("blocked_package", packageName)
        }
        startActivity(intent)

        // Immediately push the user back to home so, even if the overlay activity's
        // launch animation lags a frame, the blocked app's feed is never visible.
        performGlobalAction(GLOBAL_ACTION_HOME)
    }

    private fun logUsageEvent(packageName: String, eventType: String = "opened") {
        scope.launch {
            val db = AppDatabase.getInstance(applicationContext)
            db.usageEventDao().insert(
                UsageEvent(
                    packageName = packageName,
                    eventType = eventType,
                    timestamp = System.currentTimeMillis()
                )
            )
        }
    }

    override fun onInterrupt() { /* required override, no-op */ }

    override fun onServiceConnected() {
        super.onServiceConnected()
        // serviceInfo flags/eventTypes are also set in res/xml/accessibility_service_config.xml
        // (see below) — setting programmatically here is redundant but kept for clarity
        // if you ever need runtime-configurable flags (e.g. toggling packages without
        // a full config-XML redeploy).
    }
}
